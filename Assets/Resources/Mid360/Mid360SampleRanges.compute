#pragma kernel SampleRanges

StructuredBuffer<float3> _Directions;
RWStructuredBuffer<float2> _Ranges;
Texture2D<float2> _Depth0;
Texture2D<float2> _Depth1;
Texture2D<float2> _Depth2;
Texture2D<float2> _Depth3;
Texture2D<float2> _Depth4;
Texture2D<float2> _Depth5;
float4x4 _ViewProjections[6];
float3 _Origin;
int _Count;
int _Resolution;
float _MinRange;
float _MaxRange;

[numthreads(64, 1, 1)]
void SampleRanges(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Count) return;
    float3 d = _Directions[id.x];
    float3 a = abs(d);
    int face;
    if (a.x >= a.y && a.x >= a.z) face = d.x >= 0 ? 0 : 1;
    else if (a.y >= a.z) face = d.y >= 0 ? 2 : 3;
    else face = d.z >= 0 ? 4 : 5;

    float4 clip = mul(_ViewProjections[face], float4(_Origin + d, 1));
    float2 uv = clip.xy / clip.w * 0.5 + 0.5;
    int2 pixel = clamp(int2(uv * _Resolution), 0, _Resolution - 1);
    float2 range;
    if (face == 0) range = _Depth0.Load(int3(pixel, 0));
    else if (face == 1) range = _Depth1.Load(int3(pixel, 0));
    else if (face == 2) range = _Depth2.Load(int3(pixel, 0));
    else if (face == 3) range = _Depth3.Load(int3(pixel, 0));
    else if (face == 4) range = _Depth4.Load(int3(pixel, 0));
    else range = _Depth5.Load(int3(pixel, 0));
    _Ranges[id.x] = range.x >= _MinRange && range.x <= _MaxRange ? range : float2(-1, 0);
}
